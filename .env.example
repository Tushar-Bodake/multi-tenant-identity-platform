# ==============================================================================
# SecureGate - Multi-Tenant Authentication and Identity Platform Environment
# DO NOT COMMIT PRODUCTION SECRETS TO SOURCE CONTROL
# ==============================================================================

# Database Configuration (PostgreSQL 17)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=securegate_db
POSTGRES_USER=securegate_app
POSTGRES_PASSWORD=secure_app_password_change_me
POSTGRES_MIGRATION_USER=securegate_admin
POSTGRES_MIGRATION_PASSWORD=secure_admin_password_change_me

# Redis Configuration (Rate limiting & sessions)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Backend Application Configuration
PORT=8080
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Application Security & JWT (RS256 asymmetric keys)
# In production, provide PEM encoded RSA private and public keys or key path
JWT_ISSUER=https://auth.securegate.local
JWT_AUDIENCE=securegate-api
JWT_ACCESS_TOKEN_EXPIRATION_SECONDS=900
JWT_REFRESH_TOKEN_EXPIRATION_SECONDS=604800
# For local dev, automatic in-memory RSA keypair generation can be used if not provided
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# WebAuthn / Passkeys Configuration
WEBAUTHN_RP_NAME=SecureGate
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000

# Magic Link Authentication
MAGIC_LINK_EXPIRATION_MINUTES=15
APP_BASE_URL=http://localhost:3000

# Email (SMTP / Mailpit for local development)
SPRING_MAIL_HOST=localhost
SPRING_MAIL_PORT=1025
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
MAIL_FROM=noreply@securegate.local

# OAuth 2.0 / OIDC Providers
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
